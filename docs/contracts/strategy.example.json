{
  "schema_version": "1.0.0",
  "name": "演示：5分钟突破与全球风险过滤",
  "description": "离线合成证券示例，未启用；不代表实际行情或投资建议。宏观和规则ID需在对应环境注册。",
  "universe": {"type": "symbols", "security_ids": ["sec_fixture_a", "sec_fixture_b"], "membership_mode": "frozen_list"},
  "timeframe": "5m",
  "adjustment": {"mode": "none"},
  "filters": {
    "type": "group", "node_id": "filters", "operator": "AND",
    "children": [
      {"type": "condition", "node_id": "age", "left": {"kind": "field", "field_id": "listing_age_sessions", "timeframe": "1d", "offset": 0}, "operator": "gte", "right": {"kind": "constant", "value": 120}, "consecutive": 1},
      {"type": "condition", "node_id": "risk_warning", "left": {"kind": "field", "field_id": "is_risk_warning", "timeframe": "1d", "offset": 0}, "operator": "eq", "right": {"kind": "constant", "value": false}, "consecutive": 1}
    ]
  },
  "entry": {
    "type": "group", "node_id": "entry", "operator": "AND",
    "children": [
      {"type": "condition", "node_id": "breakout", "left": {"kind": "indicator", "indicator_id": "BREAKOUT", "timeframe": "5m", "offset": 0, "params": {"window": 20}}, "operator": "eq", "right": {"kind": "constant", "value": true}, "consecutive": 1},
      {"type": "condition", "node_id": "volume", "left": {"kind": "indicator", "indicator_id": "VOL_RATIO", "timeframe": "5m", "offset": 0, "params": {"window": 20}}, "operator": "gte", "right": {"kind": "constant", "value": 1.5}, "consecutive": 1},
      {"type": "condition", "node_id": "daily_trend", "left": {"kind": "field", "field_id": "close", "timeframe": "1d", "offset": 0}, "operator": "gt", "right": {"kind": "indicator", "indicator_id": "SMA", "timeframe": "1d", "offset": 0, "params": {"window": 20}}, "consecutive": 1}
    ]
  },
  "exit": {
    "evaluation": "completed_bar_close", "stop_loss_pct": 0.08, "take_profit_pct": 0.2, "max_holding_days": 10,
    "conditions": {
      "type": "group", "node_id": "exit", "operator": "AND",
      "children": [
        {"type": "condition", "node_id": "exit_trend", "left": {"kind": "field", "field_id": "close", "timeframe": "5m", "offset": 0}, "operator": "lt", "right": {"kind": "indicator", "indicator_id": "SMA", "timeframe": "5m", "offset": 0, "params": {"window": 20}}, "consecutive": 1}
      ]
    }
  },
  "ranking": [
    {"operand": {"kind": "indicator", "indicator_id": "MOM", "timeframe": "1d", "offset": 0, "params": {"window": 20}}, "direction": "higher", "weight": 1}
  ],
  "sizing": {"method": "equal_weight_fixed_slots", "max_holdings": 10, "target_gross_weight": 0.8, "max_single_weight": 0.1, "max_industry_weight": 0.3, "rebalance": "on_signal", "rebalance_on_risk_change": false},
  "risk_overlays": [
    {
      "rule_id": "risk_fixture_global", "enabled": true, "required_input": true,
      "scope": {"type": "all"},
      "trigger": {
        "type": "group", "node_id": "risk_trigger", "operator": "AND",
        "children": [
          {"type": "condition", "node_id": "global_drop", "left": {"kind": "macro", "series_id": "fixture_global_equity", "transform": "return", "offset": 0}, "operator": "lt", "right": {"kind": "constant", "value": -0.02}, "consecutive": 1}
        ]
      },
      "action": {"type": "position_multiplier", "value": 0.5}, "expires_at": null
    }
  ],
  "execution": {"model": "ohlcv_window_v1", "fee_model_id": "fees_fixture_v1", "ruleset_id": "rules_fixture_v1", "slippage_bps": 5, "max_participation": 0.1, "signal_expiry": "session_end", "unknown_entry_policy": "block", "unfilled_policy": "cancel_after_window"}
}
