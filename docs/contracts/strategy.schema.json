{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:personal-quant:strategy:1.0.0",
  "title": "个人A股量化策略配置",
  "description": "结构验证基线；还须执行开发规格规定的字段注册、两层组、时间语义、单位和能力校验。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "universe", "timeframe", "adjustment", "filters", "entry", "exit", "ranking", "sizing", "risk_overlays", "execution"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "name": {"type": "string", "minLength": 1, "maxLength": 80},
    "description": {"type": "string", "maxLength": 4000},
    "universe": {"$ref": "#/$defs/universe"},
    "timeframe": {"enum": ["1m", "5m", "15m", "30m", "60m", "1d"]},
    "adjustment": {
      "type": "object", "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["none", "forward", "backward"]},
        "anchor_date": {"type": "string", "format": "date"}
      },
      "allOf": [{"if": {"properties": {"mode": {"enum": ["forward", "backward"]}}}, "then": {"required": ["anchor_date"]}, "else": {"not": {"required": ["anchor_date"]}}}]
    },
    "filters": {"$ref": "#/$defs/root_group"},
    "market_filter": {"$ref": "#/$defs/root_group"},
    "entry": {"$ref": "#/$defs/root_group"},
    "exit": {
      "type": "object", "additionalProperties": false,
      "required": ["conditions", "evaluation"],
      "properties": {
        "conditions": {"$ref": "#/$defs/root_group"},
        "evaluation": {"const": "completed_bar_close"},
        "stop_loss_pct": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "take_profit_pct": {"type": "number", "exclusiveMinimum": 0, "maximum": 10},
        "max_holding_days": {"type": "integer", "minimum": 1, "maximum": 2500}
      }
    },
    "ranking": {
      "type": "array", "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["operand", "direction", "weight"],
        "properties": {
          "operand": {"$ref": "#/$defs/operand"},
          "direction": {"enum": ["higher", "lower"]},
          "weight": {"type": "number", "minimum": 0, "maximum": 1000}
        }
      }
    },
    "sizing": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "max_holdings", "target_gross_weight", "max_single_weight", "max_industry_weight", "rebalance", "rebalance_on_risk_change"],
      "properties": {
        "method": {"const": "equal_weight_fixed_slots"},
        "max_holdings": {"type": "integer", "minimum": 1, "maximum": 100},
        "target_gross_weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "max_single_weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "max_industry_weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "rebalance": {"enum": ["on_signal", "daily", "weekly"]},
        "rebalance_on_risk_change": {"const": false}
      }
    },
    "risk_overlays": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/overlay"}},
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "fee_model_id", "ruleset_id", "slippage_bps", "max_participation", "signal_expiry", "unknown_entry_policy", "unfilled_policy"],
      "properties": {
        "model": {"const": "ohlcv_window_v1"},
        "fee_model_id": {"type": "string", "minLength": 1},
        "ruleset_id": {"type": "string", "minLength": 1},
        "slippage_bps": {"type": "number", "minimum": 0, "maximum": 1000},
        "max_participation": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "signal_expiry": {"enum": ["session_end", "next_session_end"]},
        "unknown_entry_policy": {"const": "block"},
        "unfilled_policy": {"const": "cancel_after_window"}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[A-Za-z0-9_.:-]+$"},
    "timeframe": {"enum": ["1m", "5m", "15m", "30m", "60m", "1d", "1w", "1mo"]},
    "universe": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "exchanges", "membership_mode"],
          "properties": {
            "type": {"const": "market"},
            "exchanges": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["SSE", "SZSE"]}},
            "board_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
            "industry_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
            "membership_mode": {"enum": ["historical", "current_exploratory"]}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "security_ids", "membership_mode"],
          "properties": {
            "type": {"const": "symbols"},
            "security_ids": {"type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
            "membership_mode": {"const": "frozen_list"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "watchlist_id", "membership_mode"],
          "properties": {
            "type": {"const": "watchlist"},
            "watchlist_id": {"$ref": "#/$defs/id"},
            "membership_mode": {"const": "snapshot_at_run"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "index_id", "membership_mode"],
          "properties": {
            "type": {"const": "index"},
            "index_id": {"$ref": "#/$defs/id"},
            "membership_mode": {"enum": ["historical", "current_exploratory"]}
          }
        }
      ]
    },
    "operand": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {"kind": {"const": "constant"}, "value": {"type": ["number", "boolean", "string"]}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "field_id", "timeframe", "offset"],
          "properties": {
            "kind": {"const": "field"}, "field_id": {"$ref": "#/$defs/id"},
            "timeframe": {"$ref": "#/$defs/timeframe"},
            "offset": {"type": "integer", "minimum": 0, "maximum": 2500}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "indicator_id", "timeframe", "offset", "params"],
          "properties": {
            "kind": {"const": "indicator"},
            "indicator_id": {"enum": ["SMA", "EMA", "MACD_DIF", "MACD_DEA", "MACD_HIST", "RSI", "BOLL_MID", "BOLL_UPPER", "BOLL_LOWER", "MOM", "VOL_RATIO", "BREAKOUT"]},
            "timeframe": {"$ref": "#/$defs/timeframe"},
            "offset": {"type": "integer", "minimum": 0, "maximum": 2500},
            "params": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "window": {"type": "integer", "minimum": 2, "maximum": 2500},
                "fast": {"type": "integer", "minimum": 2, "maximum": 2500},
                "slow": {"type": "integer", "minimum": 3, "maximum": 2500},
                "signal": {"type": "integer", "minimum": 2, "maximum": 2500},
                "k": {"type": "number", "exclusiveMinimum": 0, "maximum": 10}
              }
            }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "series_id", "transform", "offset"],
          "properties": {
            "kind": {"const": "macro"}, "series_id": {"$ref": "#/$defs/id"},
            "transform": {"enum": ["level", "change", "return"]},
            "offset": {"type": "integer", "minimum": 0, "maximum": 2500}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "event_id", "attribute"],
          "properties": {"kind": {"const": "event"}, "event_id": {"$ref": "#/$defs/id"}, "attribute": {"const": "active"}}
        }
      ]
    },
    "condition": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "node_id", "left", "operator", "right", "consecutive"],
      "properties": {
        "type": {"const": "condition"}, "node_id": {"$ref": "#/$defs/id"},
        "left": {"$ref": "#/$defs/operand"},
        "operator": {"enum": ["gt", "gte", "lt", "lte", "eq", "neq", "crosses_above", "crosses_below"]},
        "right": {"$ref": "#/$defs/operand"},
        "consecutive": {"type": "integer", "minimum": 1, "maximum": 250}
      },
      "allOf": [{"if": {"properties": {"operator": {"enum": ["crosses_above", "crosses_below"]}}}, "then": {"properties": {"consecutive": {"const": 1}}}}]
    },
    "leaf_group": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "node_id", "operator", "children"],
      "properties": {
        "type": {"const": "group"}, "node_id": {"$ref": "#/$defs/id"},
        "operator": {"enum": ["AND", "OR"]},
        "children": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/condition"}}
      }
    },
    "root_group": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "node_id", "operator", "children"],
      "properties": {
        "type": {"const": "group"}, "node_id": {"$ref": "#/$defs/id"},
        "operator": {"enum": ["AND", "OR"]},
        "children": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"oneOf": [{"$ref": "#/$defs/condition"}, {"$ref": "#/$defs/leaf_group"}]}}
      }
    },
    "overlay": {
      "type": "object", "additionalProperties": false,
      "required": ["rule_id", "enabled", "required_input", "scope", "trigger", "action", "expires_at"],
      "properties": {
        "rule_id": {"$ref": "#/$defs/id"},
        "enabled": {"type": "boolean"}, "required_input": {"type": "boolean"},
        "scope": {
          "type": "object", "additionalProperties": false, "required": ["type"],
          "properties": {
            "type": {"enum": ["all", "securities", "industries"]},
            "ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
          },
          "allOf": [{"if": {"properties": {"type": {"const": "all"}}}, "then": {"not": {"required": ["ids"]}}, "else": {"required": ["ids"]}}]
        },
        "trigger": {"$ref": "#/$defs/root_group"},
        "action": {
          "oneOf": [
            {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"const": "block_new_entries"}}},
            {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "position_multiplier"}, "value": {"type": "number", "minimum": 0, "maximum": 1}}},
            {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "score_delta"}, "value": {"type": "number", "minimum": -1, "maximum": 1}}}
          ]
        },
        "expires_at": {"type": ["string", "null"], "format": "date-time"}
      }
    }
  }
}
